{
  "name": "agentic-kg-artifact-pipeline",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "description": "Agentic Knowledge Graph Generation Pipeline",
  "main": "dist/index.js",
  "bin": {
    "kg": "./main.sh"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist data/output/* src/generated/*/*",
    "start": "./main.sh",
    "kg": "./main.sh",
    "cli": "./main.sh",
    "merge": "bash prompts/merge-datasets.sh",
    "profile": "bash prompts/profile-data.sh",
    "parse-ontology": "bash prompts/parse-ontology.sh",
    "map": "bash prompts/create-mapping.sh",
    "clean-data": "bash prompts/clean-data.sh",
    "generate": "bash prompts/generate-graph.sh",
    "import": "bash prompts/import-to-neo4j.sh",
    "validate": "bash prompts/validate-ontology.sh",
    "validate:shacl": "bash prompts/validate-shacl.sh",
    "run:profile": "bash -c '. .env 2>/dev/null; P=${PROVIDER:-claude}; D=${DOMAIN:-$(basename ${DATA_DIR:-data})}; ts-node src/generated/$P/$D/profile-data.ts'",
    "run:parse-ontology": "bash -c '. .env 2>/dev/null; P=${PROVIDER:-claude}; D=${DOMAIN:-$(basename ${DATA_DIR:-data})}; ts-node src/generated/$P/$D/parse-ontology.ts'",
    "run:mapping": "bash -c '. .env 2>/dev/null; P=${PROVIDER:-claude}; D=${DOMAIN:-$(basename ${DATA_DIR:-data})}; ts-node src/generated/$P/$D/create-mapping.ts'",
    "run:clean": "bash -c '. .env 2>/dev/null; P=${PROVIDER:-claude}; D=${DOMAIN:-$(basename ${DATA_DIR:-data})}; ts-node src/generated/$P/$D/clean-data.ts'",
    "run:graph": "bash -c '. .env 2>/dev/null; P=${PROVIDER:-claude}; D=${DOMAIN:-$(basename ${DATA_DIR:-data})}; ts-node src/generated/$P/$D/generate-graph.ts'"
  },
  "dependencies": {
    "@types/sax": "^1.2.7",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "n3": "^1.17.2",
    "neo4j-driver": "^5.14.0",
    "papaparse": "^5.4.1",
    "rdflib": "^2.3.0",
    "sax": "^1.4.4",
    "stream-json": "^1.9.1"
  },
  "devDependencies": {
    "@types/n3": "^1.26.0",
    "@types/node": "^20.10.0",
    "@types/papaparse": "^5.3.11",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
