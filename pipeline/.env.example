# Knowledge Graph Generation Configuration

# AI Provider: which CLI tool generates code (default: claude)
# Supported: claude, codex
PROVIDER=claude
# Optional: explicit path to the Codex binary if it is not on PATH
# CODEX_BIN=/absolute/path/to/codex
# Optional: override default CLI flags for the provider
# PROVIDER_FLAGS=-p

# Data directory (where input CSVs and outputs are stored)
# Use domain-data/<domain-name> for domain-specific pipelines
DATA_DIR=domain-data/cultural-moma

# Domain name (auto-derived from DATA_DIR basename if not set)
# Generated code will be saved to src/generated/<PROVIDER>/<DOMAIN>/
# DOMAIN=cultural-moma

# Neo4j Connection Settings (for MCP integration)
NEO4J_URI=your_bolt_uri_here
NEO4J_USER=your_username_here
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=your_database_here

# MCP Server Settings (if using separate MCP configuration)
# The validation and import steps use MCP tools for Neo4j operations
MCP_NEO4J_ENABLED=true
