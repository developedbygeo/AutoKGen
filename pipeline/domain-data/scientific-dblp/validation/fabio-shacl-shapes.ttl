# ============================================================

neo4j:MastersThesisShape a sh:NodeShape ;
  sh:targetClass neo4j:MastersThesis ;

  sh:property [
    sh:path neo4j:title ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:severity sh:Violation ;
    sh:message "FaBiO Violation: MastersThesis must have dc:title. Source: Dublin Core" ;
  ] ;

  sh:property [
    sh:path neo4j:hasPublicationYear ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:severity sh:Warning ;
    sh:message "FaBiO Warning: fabio:hasPublicationYear is FunctionalProperty (max 1). Source: FaBiO OWL" ;
  ] ;

  sh:property [
    sh:path neo4j:CREATOR ;
    sh:class neo4j:Person ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:severity sh:Violation ;
    sh:message "FaBiO Violation: MastersThesis must have at least one creator. Source: Dublin Core" ;
  ] .


# ============================================================
# DataFile Shape (fabio:DataFile)
# OWL: subClassOf fabio:Expression; realization of fabio:Dataset
# ============================================================

neo4j:DataFileShape a sh:NodeShape ;
  sh:targetClass neo4j:DataFile ;

  sh:property [
    sh:path neo4j:title ;
    sh:datatype xsd:string ;
    sh:severity sh:Warning ;
    sh:message "FaBiO Warning: DataFile should have dc:title. Source: Dublin Core" ;
  ] ;

  sh:property [
    sh:path neo4j:CREATOR ;
    sh:class neo4j:Person ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Info ;
    sh:message "FaBiO Info: dcterms:creator must point to Person. Source: Dublin Core / FOAF" ;
  ] .


# ============================================================
# WebContent Shape (fabio:WebContent)
# OWL: subClassOf fabio:Expression
# ============================================================

neo4j:WebContentShape a sh:NodeShape ;
  sh:targetClass neo4j:WebContent ;

  sh:property [
    sh:path neo4j:title ;
    sh:datatype xsd:string ;
    sh:severity sh:Warning ;
    sh:message "FaBiO Warning: WebContent should have dc:title. Source: Dublin Core" ;
  ] ;

  sh:property [
    sh:path neo4j:CREATOR ;
    sh:class neo4j:Person ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Info ;
    sh:message "FaBiO Info: dcterms:creator must point to Person. Source: Dublin Core / FOAF" ;
  ] .


# ============================================================
# AcademicProceedings Shape (fabio:AcademicProceedings)
# OWL: subClassOf fabio:ExpressionCollection
# ============================================================

neo4j:AcademicProceedingsShape a sh:NodeShape ;
  sh:targetClass neo4j:AcademicProceedings ;

  sh:property [
    sh:path neo4j:title ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:severity sh:Violation ;
    sh:message "FaBiO Violation: AcademicProceedings must have dc:title. Source: Dublin Core" ;
  ] .


# ============================================================
# Journal Shape (fabio:Journal)
# OWL: subClassOf fabio:Periodical → fabio:ExpressionCollection
# ============================================================

neo4j:JournalShape a sh:NodeShape ;
  sh:targetClass neo4j:Journal ;

  sh:property [
    sh:path neo4j:title ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:severity sh:Violation ;
    sh:message "FaBiO Violation: Journal must have dc:title. Source: Dublin Core" ;
  ] .


# ============================================================
# Series Shape (fabio:BookSeries / fabio:Series)
# OWL: subClassOf fabio:Series → fabio:ExpressionCollection
# ============================================================

neo4j:SeriesShape a sh:NodeShape ;
  sh:targetClass neo4j:Series ;

  sh:property [
    sh:path neo4j:title ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:severity sh:Violation ;
    sh:message "FaBiO Violation: Series must have dc:title. Source: Dublin Core" ;
  ] .


# ============================================================
# Person Shape (foaf:Person)
# Not a FaBiO class, but used alongside it for agents
# ============================================================

neo4j:PersonShape a sh:NodeShape ;
  sh:targetClass neo4j:Person ;

  # foaf:name — every person should have a name
  sh:property [
    sh:path neo4j:name ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:severity sh:Violation ;
    sh:message "FOAF Violation: Person must have foaf:name. Source: FOAF vocabulary" ;
  ] .


# ============================================================
# Organization Shape (foaf:Organization)
# Not a FaBiO class, but used alongside for publishers
# ============================================================

neo4j:OrganizationShape a sh:NodeShape ;
  sh:targetClass neo4j:Organization ;

  sh:property [
    sh:path neo4j:name ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:severity sh:Warning ;
    sh:message "FOAF Warning: Organization should have foaf:name. Source: FOAF vocabulary" ;
  ] .
