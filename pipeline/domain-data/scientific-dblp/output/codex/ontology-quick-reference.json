        "fabio:hasManifestation",
        "fabio:hasPortrayal",
        "fabio:isManifestationOf",
        "fabio:isPortrayalOf"
      ]
    },
    {
      "class": "fabio:Item",
      "label": "item",
      "description": "A subclass of FRBR item, restricted to exemplars of fabio:Manifestations.  An example of a fabio:Item is a printed copy of a journal article on your desk, or a PDF file of that article that you purchased from a publisher and that now resides in digital form on your computer hard drive.",
      "connectedBy": [
        "fabio:hasAccessDate",
        "fabio:hasDepositDate",
        "fabio:isStoredOn",
        "fabio:stores"
      ]
    },
    {
      "class": "core:Expression",
      "label": "Expression",
      "description": "",
      "connectedBy": [
        "fabio:hasRepresentation",
        "fabio:isRepresentationOf"
      ]
    },
    {
      "class": "core:Manifestation",
      "label": "Manifestation",
      "description": "",
      "connectedBy": [
        "fabio:hasManifestation",
        "fabio:isManifestationOf"
      ]
    },
    {
      "class": "fabio:StorageMedium",
      "label": "storage medium",
      "description": "A device for recording information or storing data.",
      "connectedBy": [
        "fabio:isStoredOn",
        "fabio:stores"
      ]
    },
    {
      "class": "skos:Concept",
      "label": "concept",
      "description": "A SKOS concept can be viewed as an idea or notion; a unit of thought. However, what constitutes a unit of thought is subjective, and this definition is meant to be suggestive, rather than restrictive.\n\nThe notion of a SKOS concept is useful when describing the conceptual or intellectual structure of a knowledge organization system, and when referring to specific ideas or meanings established within a KOS.\n\nNote that, because SKOS is designed to be a vehicle for representing semi-formal KOS, such as thesauri and classification schemes, a certain amount of flexibility has been built in to the formal definition of this class.",
      "connectedBy": [
        "fabio:isSchemeOf",
        "skos:inScheme"
      ]
    },
    {
      "class": "skos:ConceptScheme",
      "label": "concept scheme",
      "description": "A SKOS concept scheme can be viewed as an aggregation of one or more SKOS concepts. Semantic relationships (links) between those concepts may also be viewed as part of a concept scheme. This definition is, however, meant to be suggestive rather than restrictive, and there is some flexibility in the formal data model stated below.\n\nThe notion of a concept scheme is useful when dealing with data from an unknown source, and when dealing with data that describes two or more different knowledge organization systems.",
      "connectedBy": [
        "fabio:isSchemeOf",
        "skos:inScheme"
      ]
    },
    {
      "class": "fabio:AcademicProceedings",
      "label": "academic proceedings",
      "description": "A document containing the programme and collected papers, or their abstracts, presented at an academic meeting.",
      "connectedBy": []
    },
    {
      "class": "fabio:AnalogManifestation",
      "label": "analog manifestation",
      "description": "A manifestation in an analog form.",
      "connectedBy": []
    },
    {
      "class": "fabio:Announcement",
      "label": "announcement",
      "description": "A formal statement about something.",
      "connectedBy": []
    },
    {
      "class": "fabio:Anthology",
      "label": "anthology",
      "description": "A collection of selected literary or scholastics works, for example poems, short stories, plays or research papers.",
      "connectedBy": []
    },
    {
      "class": "fabio:Article",
      "label": "article",
      "description": "The realization of a piece of writing on a particular topic, usually published within a periodical publication (e.g. journal, magazine and newspaper).",
      "connectedBy": []
    },
    {
      "class": "fabio:ArtisticWork",
      "label": "artistic work",
      "description": "It describes any work regarded as art in its widest sense, including works from literature and music, visual art, etc.",
      "connectedBy": []
    }
  ],
