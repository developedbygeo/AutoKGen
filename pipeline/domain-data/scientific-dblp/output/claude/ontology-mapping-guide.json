    {
      "scenario": "Endeavour (core entity, 30 connections)",
      "ontologyClass": "frbr:Endeavour",
      "requiredProperties": [],
      "optionalProperties": [
        "prism:doi",
        "fabio:hasShortTitle",
        "prism:versionIdentifier",
        "fabio:hasSICI",
        "fabio:hasCharacterCount",
        "prism:startingPage",
        "prism:edition",
        "fabio:hasPubMedId",
        "fabio:hasCopyrightYear",
        "fabio:hasElectronicArticleIdentifier",
        "fabio:hasVolumeCount",
        "fabio:hasURL",
        "prism:issueIdentifier",
        "fabio:hasSequenceIdentifier",
        "fabio:hasHandle",
        "prism:endingPage",
        "fabio:hasPageCount",
        "fabio:hasPubMedCentralId",
        "prism:publicationDate",
        "prism:issn"
      ],
      "relationships": [
        "fabio:hasPlaceOfPublication -> frbr:Place",
        "fabio:hasSubjectTerm -> fabio:SubjectTerm"
      ]
    },
    {
