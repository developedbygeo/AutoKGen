    },
    {
      "class": "geo:Geometry",
      "label": "Geometry",
      "role": "core",
      "description": "A coherent set of direct positions in space. The positions are held within a Spatial Reference System (SRS)."
    },
    {
      "class": "geo:Feature",
      "label": "Feature",
      "role": "core",
      "description": "A discrete spatial phenomenon in a universe of discourse."
    },
